# Maintainer: Peter Szabo <peter.szabo@kuleuven.be>
#
# An in-tree PKGBUILD: it packages the release binary that has already been
# built from the repository this file lives in, rather than fetching a source
# tarball. `packaging/build-arch.sh` is what drives it.
#
# That is deliberate. Building Bevy from scratch under makepkg takes about a
# quarter of an hour, and the release workflow has already built exactly the
# binary we want to ship in the job before this one. An AUR submission would
# want a different PKGBUILD, with `source=(...)` pointing at a release tag and
# a real build() -- see packaging/README.md.

pkgname=beavyr
# Read from Cargo.toml so the package version cannot drift from the crate's.
pkgver=$(grep -m1 '^version' "$startdir/../Cargo.toml" | cut -d'"' -f2)
pkgrel=1
pkgdesc="Molecular viewer and quantum-chemistry front-end"
arch=('x86_64')
url="https://github.com/pszabo/beavyr"
license=('MPL2')

# System libraries linked by the viewer; Bevy audio support is disabled.
depends=('libcap' 'systemd-libs')

# Opened by name at run time rather than linked, so ldd cannot see them and
# the package must not hard-require them. A working desktop has them all;
# without a Vulkan driver the viewport will not start, which is why the loader
# and Mesa lead the list.
optdepends=('vulkan-icd-loader: required for the 3D viewport'
            'vulkan-radeon: Vulkan driver for AMD GPUs'
            'vulkan-intel: Vulkan driver for Intel GPUs'
            'nvidia-utils: Vulkan driver for NVIDIA GPUs'
            'libxkbcommon: keyboard handling'
            'libx11: X11 session support'
            'libxcursor: X11 cursor themes'
            'libxrandr: X11 display configuration'
            'libxi: X11 input devices'
            'wayland: Wayland session support')

# !strip because build-arch.sh has already stripped the binary; !debug so
# makepkg does not copy source files into /usr/src/debug for a debug package
# we are not producing.
options=('!strip' '!debug')

package() {
  local root="$startdir/.."
  local here="$startdir"

  # Cargo names the binary after the crate, with a capital B; on a command
  # line that is awkward, so it goes in as lowercase -- matching the .deb.
  install -Dm0755 "$root/target/release/Beavyr" "$pkgdir/usr/bin/beavyr"

  install -Dm0644 "$here/beavyr.desktop" \
    "$pkgdir/usr/share/applications/beavyr.desktop"
  install -Dm0644 "$here/beavyr.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/beavyr.svg"
  install -Dm0644 "$here/be.kuleuven.Beavyr.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/be.kuleuven.Beavyr.metainfo.xml"
  install -Dm0644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
